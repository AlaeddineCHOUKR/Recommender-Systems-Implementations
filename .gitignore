# =================================================================
# Data & Datasets
# Do not commit large data files. This is the most important rule.
# =================================================================
data/


# =================================================================
# Python & Virtual Environments
# Ignore compiled Python files, caches, and virtual environments.
# =================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
env/
*.env


# =================================================================
# IDE & OS Specific Files
# Ignore metadata files from common editors and operating systems.
# =================================================================
.vscode/
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# =================================================================
# Results, Logs, and Visualizations
# Ignore any files generated by running the scripts.
# =================================================================
results_*/
*.log
*.png
*.jpg
*.jpeg
*.svg